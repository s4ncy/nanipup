---
import Base from '../../layouts/Base.astro';
import HeroPhoto from '../../components/HeroPhoto.astro';
import RouteMap from '../../components/RouteMap.astro';
import PackArt from '../../components/PackArt.astro';
import Inquiry from '../../components/Inquiry.astro';
---
<Base lang="sl" title="Nani Pup — alpsko varstvo psov, dogodivščine in fotografiranje" description="Individualno alpsko varstvo psov, pasji Adventure Day, fotografiranje psa z družino in uporabni Field Notes za Bled, Bohinj, Kranjsko Goro, Gorenjsko in izbrane termine v Ljubljani." alternateEn="/" alternateSl="/sl/">
<section class="hero">
  <div class="rail">ALPSKO VARSTVO · ZGODBE · SLOVENIJA</div>
  <div class="heroMain">
    <div class="eyebrow">Navdihnila Nani / Alpine care & stories</div>
    <h1 class="mega">NANI <span class="pup">Pup.</span></h1>
    <div class="sub">Dobro varstvo. Lepi dnevi zunaj. <em>Več dogodivščin skupaj.</em></div>
    <p class="intro">Nani Pup je zrasel iz ene kužke in krajev, ki jih je imela rada. Danes skrbimo za vaše pse, primerne kužke peljemo na iste alpske poti, fotografiramo vaš odnos in delimo uporabno lokalno znanje za lepše življenje in potovanja s psom.</p>
    <div class="actions"><a class="pill dark" href="#care">Poglej Alpine Care →</a><a class="pill" href="/sl/fotografiranje-psa-z-druzino/">Poglej Nani Memories</a></div>
    <div class="stamp"><div><strong>Alpine</strong><br/>Bled · Bohinj<br/>Kranjska Gora</div></div>
  </div>
  <HeroPhoto lang="sl" />
</section>
<div class="ticker"><div>✦ ALPINE CARE &nbsp; ✦ PASJI ADVENTURE DAY &nbsp; ✦ FOTOGRAFIRANJE PSA Z DRUŽINO &nbsp; ✦ FIELD NOTES &nbsp; ✦ KRANJSKA GORA &nbsp; ✦ BLED &nbsp; ✦ BOHINJ &nbsp; ✦ GORENJSKA &nbsp; ✦ NANI GOODS &nbsp;</div></div>

<section class="statement naniStory">
 <div class="big"><div class="kicker">01 / Navdihnila Nani</div><h2>Kužka, zaradi katere je Nani Pup sploh <em>nastal.</em></h2></div>
 <div class="sidecopy"><p>Nani je Nani Pup dala ime, srce in razlog, da ta zgodba obstaja. Najraje je imela tiste preproste pasje dneve: hladne gozdne poti, zrak ob jezeru, dolge postanke za vohanje in človeka nekje blizu. Kraji, kjer je bila najbolj srečna, so postali začetek Nani Pup. Danes se nanje vračamo z vašimi kužki — Nani pack je danes samo malo večji.</p><div class="proofs"><div class="proof"><b>care</b><span>Mirno in osebno varstvo, prilagojeno kužku pred nami.</span></div><div class="proof"><b>poti</b><span>Kraji, ki jih je Nani poznala in imela rada, zdaj tudi za vaše.</span></div><div class="proof"><b>zgodbe</b><span>Fotografije in drobni spomini, ki jih je vredno ohraniti.</span></div></div></div>
</section>

<section class="services" id="care"><div class="sectionHead"><div><div class="kicker">02 / Alpine Care</div><h2>Varstvo za dan,<br/>ki ga potrebuje tvoj kuža.</h2></div><p>Individualno, omejeno varstvo za domačine in goste. Včasih je pravi odgovor miren sprehod in počitek. Včasih pa cela pasja dogodivščina.</p></div><div class="serviceRows">
<a class="service" href="/sl/varstvo-psov-gorenjska/"><span class="num">A</span><h3>Individualno Nani varstvo</h3><p>Sprehodi, družba, hrana, počitek in njegova običajna rutina.</p><span class="arrow">↗</span></a>
<a class="service" href="/sl/pasji-adventure-dan/"><span class="num">B</span><h3>Pasji Adventure Day</h3><p>Tvoj kuža dobi svoj prilagojen izlet, medtem ko imaš ti svojega.</p><span class="arrow">↗</span></a>
<a class="service" href="/sl/porocni-pasji-concierge/"><span class="num">C</span><h3>Poročni pasji concierge</h3><p>Prevzem, prevoz, obred, fotografije, odmori in varstvo.</p><span class="arrow">↗</span></a>
<a class="service" href="/sl/varstvo-psov-bohinj/"><span class="num">D</span><h3>Bohinj & alpska bivanja</h3><p>Individualno varstvo v Bohinju in po bližnji Gorenjski po dogovoru.</p><span class="arrow">↗</span></a>
</div></section>

<RouteMap lang="sl" />

<section class="adventure"><div class="adventureCopy"><div class="kicker">04 / Nani Adventure Day</div><h2>Tudi on dobi svojo dogodivščino.</h2><p>Več kot samo varstvo. Kužka prevzamemo in mu sestavimo nekaj dobrih ur po njegovi meri: gozd, vohanje, gibanje, voda, počitek in fotografije in kratka sporočila zate. Brez osvajanja vrha za vsako ceno — pot izberemo za psa.</p><div class="actions"><a class="pill" href="/sl/pasji-adventure-dan/">Poglej Adventure Day →</a><a class="pill" href="#inquiry">Vprašaj za termin</a></div></div><div class="adventureTicket"><div class="eyebrow">NANI FIELD TICKET / 001</div><div class="ticketTitle">Pasji Adventure Day</div><div class="ticketList"><div>✓ 3–4 ure prilagojenega izleta</div><div>✓ Kranjska Gora / Bled / Bohinj po dogovoru</div><div>✓ voda, počitki in mentalna zaposlitev</div><div>✓ fotografije + kratka sporočila</div><div>✓ pot prilagojena psu in vremenu</div></div><div class="ticketPrice">od 85 €</div></div></section>

<section class="memories" id="memories"><div class="memGrid"><div class="postcards"><div class="card one"><div class="photoMock photoMockDog"></div></div><div class="card two"><div class="photoMock photoMockFamily"></div></div></div><div class="memCopy"><div class="kicker">05 / Nani Memories</div><h2>Ohrani poglavje, v katerem ste zdaj.</h2><p>Sproščeno fotografiranje psa z družino na Bledu, v Bohinju, Kranjski Gori in po Gorenjski. Sprehod, vajin kraj, vajini ljudje in kuža, ki sodi v sredino zgodbe — brez občutka togega pasjega portreta.</p><div class="pricebig">od 300 €</div><a class="pill dark" href="/sl/fotografiranje-psa-z-druzino/">Poglej Nani Memories →</a></div></div></section>

<section class="journal" id="journal"><div class="sectionHead"><div><div class="kicker">06 / Nani Field Notes</div><h2>Stvari, ki jih veš,<br/>ker si tam dejansko bil.</h2></div><p>Lokalne pasje beležke iz krajev, ki jih poznamo: kje je dan prijeten, kaj upoštevati pred potjo, kako s psom potovati bolj mirno in kdaj nekaj ur individualnega varstva olajša dan vsem.</p></div><div class="journalGrid">
<a class="story" href="/sl/blog/bled-s-psom/"><span class="tag">Bled s psom</span><div><h3>Bled s psom</h3><p>Sprehodi, jezero, praktične posebnosti in ideje za sproščen dan ob Bledu.</p></div><span class="read">Preberi →</span></a>
<a class="story" href="/sl/blog/kranjska-gora-s-psom/"><span class="tag">Kranjska Gora</span><div><h3>Kranjska Gora s psom</h3><p>Alpske poti, pravila v naravi in realno planiranje dneva s kužkom.</p></div><span class="read">Preberi →</span></a>
<a class="story" href="/sl/blog/bohinj-s-psom/"><span class="tag">Bohinj</span><div><h3>Bohinj s psom</h3><p>Voda, senca, počasnejši dnevi ob jezeru in spoštljivo gibanje v naravi.</p></div><span class="read">Preberi →</span></a>
<a class="story" href="/sl/blog/potovanje-po-sloveniji-s-psom/"><span class="tag">Slovenija s psom</span><div><h3>Potovanje po Sloveniji s psom</h3><p>Nastanitve, izleti, vročina, počitek in logistika, ki naredi dopust lažji.</p></div><span class="read">Preberi →</span></a>
</div><div class="actions" style="margin-top:36px"><a class="pill dark" href="/sl/blog/">Vsi Field Notes →</a><a class="pill" href="/sl/izziv/">Brezplačni 7-dnevni izziv</a></div></section>

<section class="challenge compactChallenge"><div class="challengeTop"><div><div class="kicker">07 / Uči se z Nani</div><h2>Vsak dan nekaj malega.<i>Skupaj.</i></h2></div><div class="challengeIntro">Brezplačni 7-dnevni izziv prinese eno kratko, uporabno nalogo na dan — dovolj preprosto za resnično življenje in dovolj uporabno, da jo odneseš na običajen sprehod.<br/><br/><a class="pill dark" href="/sl/izziv/">Pridruži se brezplačno →</a></div></div></section>

<section class="shop softSell" id="shop"><div class="shopLead"><div class="kicker">08 / Nani Goods</div><h2>Ko želiš košček Nani odnesti domov.</h2><p>Majhen izbor za ljudi, ki imajo radi premišljene pasje stvari: lokalni vodiči, bolj zanimivi sprehodi, spomini in sčasoma tudi mirna Nani WALK kolekcija. Brez ogromnega kataloga.</p><div class="fieldseal">malo<br/>uporabno<br/>lepo</div></div><div class="products">
<a class="product sun" href="/sl/trgovina/"><span class="type">Digitalni vodič</span><div><h3>Bled s psom</h3><p>Praktičen lokalni vodič za lepše dni ob jezeru.</p></div><span class="price">19 €</span></a>
<a class="product" href="/sl/trgovina/"><span class="type">Sprehod & učenje</span><div><h3>Adventure kartice</h3><p>Mini igre in ideje za bolj bogate vsakodnevne sprehode.</p></div><span class="price">12 €</span></a>
<a class="product" href="/sl/trgovina/"><span class="type">Spomini</span><div><h3>Nani Memory Journal</h3><p>Za navade, male zgodbe in stvari, ki jih nočeš pozabiti.</p></div><span class="price">29 €</span></a>
<a class="product dark" href="/sl/trgovina/"><span class="type">Prihaja / Nani WALK</span><div><h3>Minimalistični alpski kosi</h3><p>Minimalni oprsniki, povodci in vsakodnevni kosi za udobne dogodivščine.</p></div><span class="price">Kmalu</span></a>
</div></section>

<section class="packSection"><div class="packCopy"><div class="kicker">09 / Pack raste</div><h2>Nani je začela zgodbo.<br/><em>Vaši kužki jo peljejo naprej.</em></h2><p>Vsak kuža ima drugačen tempo, najljubši vonj in svojo predstavo popolnega dne. In ravno v tem je ves čar.</p></div><PackArt lang="sl" /></section>

<Inquiry lang="sl" />
</Base>
